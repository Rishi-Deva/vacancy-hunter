# Образец файла секретов. Скопируйте в .env и впишите значения:
#   cp .env.example .env && chmod 600 .env && nano .env
# Файл .env в репозиторий не попадает. Пароли придумайте длинные и разные.
#
# Каждое значение передаётся только тому контейнеру, которому оно нужно
# (см. docker-compose.yml). Контейнер app не получает данных администратора
# и пользователя миграций.

# --- База данных: имена баз ---
DB_NAME=vacancy_hunter
DB_TEST_NAME=vacancy_hunter_test

# --- Администратор PostgreSQL ---
# Нужен только контейнеру db при первом запуске: создаёт базы, роли и расширение pg_trgm.
POSTGRES_ADMIN_USER=hunter_admin
POSTGRES_ADMIN_PASSWORD=

# --- Пользователь миграций ---
# Владелец схемы проекта. Используется только сервисом migrate.
DB_MIGRATOR_USER=hunter_migrator
DB_MIGRATOR_PASSWORD=

# --- Пользователь приложения ---
# Только SELECT, INSERT, UPDATE, DELETE. Используется контейнером app.
DB_APP_USER=hunter_app
DB_APP_PASSWORD=

# --- Пользователь тестовой базы ---
# Владелец только тестовой базы DB_TEST_NAME. Нужен для запуска тестов в контейнере app.
# К рабочей базе доступа не имеет.
DB_TEST_USER=hunter_test
DB_TEST_PASSWORD=

# --- Понадобятся на следующих шагах (на шаге A1 можно оставить пустыми) ---
# Шаг A2: токен нового бота от @BotFather и ваш числовой идентификатор в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Шаг A2: адрес внешнего пульса (необязательно: без него пульс отключается)
HEARTBEAT_URL=
# Шаг A5: ключ API Claude
ANTHROPIC_API_KEY=
